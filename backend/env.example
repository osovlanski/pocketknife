# ===========================================
# Pocketknife - Backend Environment Variables
# ===========================================
# Rename this file to .env and fill in your values

# ============ SERVER CONFIG ============
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============ DATABASE ============
# PostgreSQL connection string
# For Neon (free): postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# For local development: postgres://postgres:password@localhost:5432/pocketknife
DATABASE_URL=postgres://user:password@localhost:5432/pocketknife

# Default user email (for single-user mode)
DEFAULT_USER_EMAIL=your-email@example.com

# ============ REDIS CACHE (Optional) ============
# For Upstash Redis (free tier): redis://default:xxx@xxx.upstash.io:6379
# Leave empty to use memory-only cache
REDIS_URL=
UPSTASH_REDIS_URL=

# ============ REQUIRED ============

# Anthropic Claude API Key (for AI features)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# ============ GOOGLE OAUTH2 ============
# For Gmail and Drive access
# Create at: https://console.cloud.google.com/apis/credentials
# See GOOGLE_SETUP.md for step-by-step instructions

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Drive folder for invoices (optional)
DRIVE_FOLDER_ID=your-drive-folder-id

# ============ SHOPPING - ISRAELI SHOPS ============
# Google Custom Search API for Israeli e-commerce
# Create at: https://cse.google.com/ and https://console.cloud.google.com/apis/credentials
# Free tier: 100 queries/day, then falls back to Zap.co.il scraper

GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# ============ JOB SEARCH APIs ============

# RapidAPI Key (for JSearch - LinkedIn, Glassdoor, Indeed aggregator)
# FREE tier: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your-rapidapi-key

# Adzuna API (for international job boards)
# FREE: https://developer.adzuna.com/
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key

# ============ TRAVEL APIs ============

# Amadeus API (for flights and hotels)
# Get yours at: https://developers.amadeus.com/
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# ============ NOTIFICATIONS (Optional) ============

# Email Notifications
ALERT_EMAIL=your-email@example.com
NOTIFICATION_METHOD=email  # Options: email, discord, telegram, all

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ============ NOTION INTEGRATION ============
# Get your token at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxx

# ============ MEILISEARCH (Local Search) ============
# Setup: docker run -d --name meilisearch -p 7700:7700 getmeili/meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=                    # Optional for local, required for production

# ============ SERPAPI (Web Search) ============
# Free tier: 100 searches/month - https://serpapi.com/
SERPAPI_KEY=your-serpapi-key

# ============ FACEBOOK INTEGRATION ============
# Get your credentials at: https://developers.facebook.com/apps
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret

# Twilio WhatsApp (alternative)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=your-twilio-whatsapp-number

# ============ EMAIL PROCESSING ============

# Minimum confidence threshold for email classification (0-1)
CONFIDENCE_THRESHOLD=0.75

# ============ COOKING AGENT APIs ============

# Spoonacular API (for recipe search, nutrition, meal planning)
# Get yours at: https://spoonacular.com/food-api
# FREE tier: 150 requests/day
SPOONACULAR_API_KEY=your-spoonacular-api-key

# ============ DELIVERY SERVICES ============

# Wolt Drive API (for grocery delivery)
# Requires Wolt Drive Merchant account
# See: https://wolt.com/en/drive
WOLT_API_TOKEN=your-wolt-api-token
WOLT_MERCHANT_ID=your-wolt-merchant-id
WOLT_VENUE_ID=your-wolt-venue-id
