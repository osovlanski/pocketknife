# ===========================================
# Pocketknife - Production Environment Variables
# ===========================================
# Copy this file and set values in your deployment platform
# DO NOT commit actual values to source control!

# ============ SERVER CONFIG ============
PORT=5000
NODE_ENV=production

# Your Vercel frontend URL (update after deployment)
FRONTEND_URL=https://your-app.vercel.app

# ============ DATABASE (Neon PostgreSQL) ============
# Get from: https://neon.tech → Your Project → Connection Details
# Format: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxx-xxx-123456.region.aws.neon.tech/neondb?sslmode=require

# Default user email for single-user mode
DEFAULT_USER_EMAIL=your-email@example.com

# ============ REDIS CACHE (Upstash) ============
# Get from: https://upstash.com → Your Database → Redis URL
# Format: redis://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://default:xxxxx@memorable-name-12345.upstash.io:6379
UPSTASH_REDIS_URL=redis://default:xxxxx@memorable-name-12345.upstash.io:6379

# ============ AI PROVIDER ============
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx

# ============ GOOGLE OAUTH2 ============
# Create at: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Update redirect URI to your Railway backend URL!
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/auth/google/callback

# Google Drive folder for invoices (optional)
DRIVE_FOLDER_ID=your-drive-folder-id

# ============ SHOPPING - GOOGLE CUSTOM SEARCH ============
# Create at: https://console.cloud.google.com/apis/credentials
# Free tier: 100 queries/day
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# ============ JOB SEARCH APIs ============
# RapidAPI - JSearch (LinkedIn, Glassdoor aggregator)
# Free at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your-rapidapi-key

# Adzuna API (international job boards)
# Free at: https://developer.adzuna.com/
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key

# ============ TRAVEL APIs ============
# Amadeus API (flights and hotels)
# Free at: https://developers.amadeus.com/
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# ============ NOTIFICATIONS (Optional) ============
ALERT_EMAIL=your-email@example.com
NOTIFICATION_METHOD=email

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=

# ============ THRESHOLDS ============
CONFIDENCE_THRESHOLD=0.75

