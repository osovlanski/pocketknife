// =============================================================================
// EXTERNAL COMPANIES (Comeet, Greenhouse, Lever, etc.)
// =============================================================================

// Company size enum for job search filtering
enum CompanySizeCategory {
  STARTUP       // 1-50 employees
  MIDSIZE       // 51-500 employees
  ENTERPRISE    // 500+ employees
}

// ATS (Applicant Tracking System) provider enum
enum ATSProvider {
  COMEET
  GREENHOUSE
  LEVER
  WORKDAY
  ASHBY
  OTHER
}

// Status of the company record
enum ExternalCompanyStatus {
  ACTIVE        // Actively fetching jobs
  INACTIVE      // Temporarily disabled
  INVALID       // Invalid credentials/config
  PENDING       // Awaiting verification
}

model ExternalCompany {
  id        String   @id @default(uuid())
  
  // Company identification
  name              String
  slug              String   @unique // URL-friendly identifier
  
  // ATS Configuration
  atsProvider       ATSProvider
  atsCompanyId      String    // e.g., Comeet's "uid"
  atsToken          String?   // e.g., Comeet's "token" (public tokens only)
  atsApiKey         String?   // For private API access (encrypted)
  atsConfig         Json?     // Additional ATS-specific configuration
  
  // Company metadata (can be enriched from Crunchbase, LinkedIn, etc.)
  description       String?   @db.Text
  industry          String?
  industries        String[]  // Multiple industries
  size              CompanySizeCategory?
  employeeCountMin  Int?
  employeeCountMax  Int?
  employeeCount     String?   // Human-readable, e.g., "500-1000"
  
  // Funding information
  fundingStage      String?   // "Seed", "Series A", "Series B", etc.
  totalFunding      String?   // "$50M", "$100M", etc.
  totalFundingUsd   Float?    // Numeric value for filtering
  lastFundingDate   DateTime?
  investors         String[]
  
  // Company details
  founded           String?   // Year founded
  headquarters      String?
  locations         String[]  // All office locations
  website           String?
  
  // External links
  crunchbaseUrl     String?
  linkedinUrl       String?
  glassdoorUrl      String?
  careersUrl        String?
  
  // Scores and ratings
  glassdoorRating   Float?    // 1-5
  growthScore       Int?      // 1-10
  heatScore         Int?      // 1-10 (trending/hiring activity)
  companyScore      Int?      // 0-100 (calculated overall score)
  
  // Status and validation
  status            ExternalCompanyStatus @default(PENDING)
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?   // Admin who verified
  
  // Discovery metadata
  discoveredAt      DateTime  @default(now())
  discoverySource   String?   // "google_search", "manual", "crunchbase", etc.
  discoveryUrl      String?   // URL where company was discovered
  
  // Data freshness
  lastEnrichedAt    DateTime?
  lastJobFetchAt    DateTime?
  jobFetchErrors    Int       @default(0) // Count of consecutive fetch errors
  lastErrorMessage  String?
  
  // Statistics
  totalJobsFetched  Int       @default(0)
  activeJobsCount   Int       @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  jobs      ExternalJob[]
  
  @@unique([atsProvider, atsCompanyId])
  @@index([status])
  @@index([atsProvider])
  @@index([size])
  @@index([industry])
  @@index([companyScore])
  @@index([name])
}

model ExternalJob {
  id        String   @id @default(uuid())
  
  companyId String
  company   ExternalCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Job identification
  externalId        String    // ID from the ATS
  source            String    // "comeet", "greenhouse", etc.
  
  // Job details
  title             String
  department        String?
  location          String
  locationType      String?   // "onsite", "remote", "hybrid"
  
  // Employment details
  employmentType    String?   // "fulltime", "parttime", "contract", "internship"
  experienceLevel   String?   // "junior", "mid", "senior", "lead"
  salaryMin         Float?
  salaryMax         Float?
  salaryCurrency    String?
  
  // Description
  description       String    @db.Text
  requirements      String?   @db.Text
  niceToHave        String?   @db.Text
  benefits          String?   @db.Text
  
  // Application
  applyUrl          String
  
  // Tags and categories
  tags              String[]
  skills            String[]  // Required skills extracted from description
  
  // Status
  isActive          Boolean   @default(true)
  postedAt          DateTime?
  expiresAt         DateTime?
  
  // Timestamps
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([companyId, externalId])
  @@index([isActive])
  @@index([title])
  @@index([location])
  @@index([experienceLevel])
  @@index([postedAt])
}

