// Pocketknife Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts (Prisma 7+ requirement)
}

// =============================================================================
// USER & PREFERENCES
// =============================================================================

// User roles enum
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// User status enum  
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  avatarUrl String?
  
  // Role-based access control
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  
  // Authentication
  passwordHash  String?   // For future password auth
  lastLoginAt   DateTime?
  loginCount    Int       @default(0)
  
  // Admin metadata
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?   // Admin who verified this user
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  preferences    UserPreferences?
  solvedProblems SolvedProblem[]
  tripPlans      TripPlan[]
  jobSearches    JobSearch[]
  savedJobs      SavedJob[]
  emailStats     EmailStats?
  activityLogs   ActivityLog[]
  
  // ToDo Agent relations
  tasks          Task[]
  routinePatterns RoutinePattern[]
  calendarSync   CalendarSync?
  
  // Shopping Agent relations
  productSearches ProductSearch[]
  products       Product[]
  userInterests  UserInterest[]
  priceAlerts    PriceAlert[]
  
  // Groceries Agent relations
  groceryItems    GroceryItem[]
  recipes         SavedRecipe[]
  groceryLists    GroceryList[]
  ramiLevyToken   RamiLevyToken?
  
  // News Agent relations
  newsPreferences  NewsPreference?
  newsInteractions NewsInteraction[]
  savedArticles    SavedNewsArticle[]
  
  // DIY Agent relations
  diyProjects      DIYProject[]
  
  // Admin relations
  adminActions   AdminAuditLog[] @relation("AdminActions")
  systemSettings SystemSetting[]

  @@index([email])
  @@index([role])
  @@index([status])
}

// =============================================================================
// OAUTH TOKENS (for Google, etc.)
// =============================================================================

model OAuthToken {
  id           String   @id @default(uuid())
  provider     String   // "google", "linkedin", etc.
  userEmail    String   // The email associated with this token
  
  // Token data
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  tokenType    String   @default("Bearer")
  scope        String?  @db.Text
  expiryDate   DateTime?
  
  // Metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([provider, userEmail])
  @@index([provider])
  @@index([userEmail])
}

model UserPreferences {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Job preferences
  preferredLocations  String[]
  preferredJobTypes   String[]  // ["Remote", "Hybrid", "Office Only"]
  preferredCompanies  String[]
  minSalary           Int?
  maxSalary           Int?
  experienceLevel     String?   // "Junior", "Mid", "Senior"

  // Travel preferences
  preferredAirlines   String[]
  homeAirport         String?
  preferredHotelClass Int?      // 1-5 stars

  // Problem solving preferences
  preferredLanguage   String    @default("javascript")
  completedLists      String[]  // ["blind75", "neetcode150", "grind75"]
  preferredDifficulty String?   // "Easy", "Medium", "Hard"

  // Email preferences
  autoArchiveSpam     Boolean   @default(false)
  emailDigestTime     String?   // "09:00" - when to send daily digest
  
  // Notification preferences
  notificationMethod  String    @default("email")  // "email", "discord", "telegram", "all"
  
  // ToDo preferences
  defaultTaskDuration  Int?      // Default duration in minutes
  workingHoursStart    String?   // "09:00"
  workingHoursEnd      String?   // "17:00"
  weekendEnabled       Boolean   @default(false)
  
  // Shopping preferences
  preferredCurrency    String    @default("USD")
  dealScoreThreshold   Int       @default(70)  // Minimum deal score to notify
  favoriteCategories   String[]
  favoriteBrands       String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// PROBLEM SOLVING
// =============================================================================

model SolvedProblem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  problemId   String   // External ID (e.g., "two-sum" for LeetCode)
  title       String
  source      String   // "LeetCode", "Codeforces", "HackerRank", "Curated"
  difficulty  String   // "Easy", "Medium", "Hard"
  language    String   // Programming language used
  code        String   @db.Text
  score       Int?     // AI evaluation score 0-100
  timeSpent   Int?     // Time spent in seconds
  hints       Int      @default(0) // Number of hints used
  attempts    Int      @default(1)
  
  // Tags for filtering
  topics      String[] // ["Array", "Two Pointers", "HashMap"]
  companyTags String[] // ["Google", "Amazon"]
  listTags    String[] // ["blind75", "neetcode150"]

  solvedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId, source])
  @@index([userId, solvedAt])
  @@index([source, difficulty])
}

// =============================================================================
// TRAVEL PLANNING
// =============================================================================

model TripPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Trip details
  name        String?
  origin      String
  destination String
  departDate  DateTime
  returnDate  DateTime?
  travelers   Int       @default(1)
  tripType    String    @default("roundtrip") // "roundtrip", "oneway", "multicity"

  // Budget
  budgetMin   Float?
  budgetMax   Float?
  currency    String    @default("USD")

  // Search results (stored as JSON for flexibility)
  flights     Json?     // Array of flight offers
  hotels      Json?     // Array of hotel offers
  activities  Json?     // Array of suggested activities

  // Status tracking
  status      String    @default("planning") // "planning", "booked", "completed", "cancelled"
  bookedAt    DateTime?
  
  // Notes
  notes       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([departDate])
}

// =============================================================================
// JOB SEARCH
// =============================================================================

model JobSearch {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Search parameters
  query        String
  location     String?
  jobType      String?   // "Remote", "Hybrid", "Office Only"
  filters      Json?     // Additional filters as JSON

  // Results
  resultsCount Int       @default(0)
  topMatches   Json?     // Top matching jobs with scores

  // CV used for this search
  cvHash       String?   // Hash of CV content to detect changes

  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
  @@index([query])
}

model SavedJob {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Job details
  jobId       String   // External job ID
  title       String
  company     String
  location    String?
  jobType     String?  // "Remote", "Hybrid", "Office Only"
  salary      String?
  description String?  @db.Text
  url         String?
  source      String   // "LinkedIn", "Geektime", "AllJobs", etc.

  // Match info
  matchScore  Int?     // AI matching score 0-100
  matchReason String?  @db.Text

  // Company enrichment
  companyInfo Json?    // Crunchbase-like data

  // Status
  status      String   @default("saved") // "saved", "applied", "interviewing", "rejected", "accepted"
  appliedAt   DateTime?
  notes       String?  @db.Text

  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId, source])
  @@index([userId, status])
}

// =============================================================================
// EMAIL MANAGEMENT
// =============================================================================

model EmailStats {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Lifetime stats
  totalProcessed     Int      @default(0)
  invoicesProcessed  Int      @default(0)
  jobOffersFound     Int      @default(0)
  spamDeleted        Int      @default(0)
  newslettersArchived Int     @default(0)

  // Session tracking
  lastProcessedAt    DateTime?
  lastEmailId        String?   // For incremental processing

  updatedAt DateTime @updatedAt
}

// =============================================================================
// ACTIVITY LOGGING
// =============================================================================

model ActivityLog {
  id     String @id @default(uuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Activity details
  agent     String   // "email", "job", "travel", "problem", "learning"
  action    String   // "search", "process", "save", "delete", etc.
  details   String?  @db.Text
  metadata  Json?    // Additional structured data

  // Status
  status    String   @default("success") // "success", "error", "warning"
  error     String?  @db.Text

  createdAt DateTime @default(now())

  @@index([agent, createdAt])
  @@index([userId, createdAt])
}

// =============================================================================
// APP CONFIGURATION
// =============================================================================

model AppConfig {
  id        String   @id
  value     Json
  category  String?  // "api", "feature", "limit", etc.
  
  updatedAt DateTime @updatedAt
}

// =============================================================================
// CACHE METADATA (for cache invalidation tracking)
// =============================================================================

model CacheEntry {
  key       String   @id
  expiresAt DateTime
  tags      String[] // For tag-based invalidation
  
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([tags])
}

// =============================================================================
// TODO AGENT
// =============================================================================

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Task details
  title       String
  description String?   @db.Text
  priority    String    @default("medium") // "low", "medium", "high", "urgent"
  status      String    @default("pending") // "pending", "in_progress", "completed", "cancelled"
  dueDate     DateTime?
  dueTime     String?   // "09:00", "14:30" etc.
  duration    Int?      // Estimated duration in minutes
  
  // Recurrence
  isRecurring   Boolean   @default(false)
  recurrenceRule String?  // "daily", "weekly", "monthly", "weekdays", "custom:MON,WED,FRI"
  
  // Categories & tags
  category    String?   // "work", "personal", "health", "learning", "errands"
  tags        String[]
  
  // Google Calendar sync
  googleEventId   String?
  lastSyncedAt    DateTime?
  syncEnabled     Boolean   @default(false)
  
  // Completion tracking
  completedAt   DateTime?
  completedCount Int       @default(0) // For recurring tasks
  
  // Pattern learning
  sourceType    String    @default("manual") // "manual", "routine", "suggested"
  confidence    Float?    // AI confidence for suggested tasks
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, category])
}

model RoutinePattern {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Pattern details
  patternName   String
  description   String?
  
  // When this routine happens
  dayOfWeek     String[]  // ["monday", "tuesday", "wednesday", "thursday", "friday"]
  timeSlot      String?   // "morning", "afternoon", "evening"
  preferredTime String?   // "09:00"
  
  // What the routine involves
  taskTemplate  Json      // Template for creating tasks
  
  // Learning metrics
  frequency     Int       @default(0)  // How many times detected
  lastOccurred  DateTime?
  avgDuration   Int?      // Average duration in minutes
  confidence    Float     @default(0.5) // AI confidence 0-1
  
  // User feedback
  isApproved    Boolean   @default(false)
  isDismissed   Boolean   @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isApproved])
}

model CalendarSync {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Google Calendar OAuth
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?
  calendarId    String    @default("primary")
  
  // Sync settings
  syncEnabled       Boolean   @default(true)
  syncDirection     String    @default("both") // "to_google", "from_google", "both"
  lastSyncAt        DateTime?
  lastSyncError     String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// SHOPPING AGENT
// =============================================================================

model ProductSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Search query
  query         String
  queryType     String   @default("explicit") // "explicit", "hobby_based"
  originalPrompt String? @db.Text
  
  // Results
  resultsCount  Int      @default(0)
  
  createdAt DateTime @default(now())
  
  // Relations
  products      Product[]
  
  @@index([userId, createdAt])
}

model Product {
  id        String   @id @default(uuid())
  searchId  String?
  search    ProductSearch? @relation(fields: [searchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Product details
  title         String
  description   String?   @db.Text
  price         Float
  originalPrice Float?    // Original price before discount
  currency      String    @default("USD")
  discount      Float?    // Discount percentage
  
  // Source info
  source        String    // "ebay", "aliexpress", "amazon", "telegram"
  sourceUrl     String
  sourceId      String?   // External product ID
  imageUrl      String?
  
  // Deal quality
  dealScore     Float?    // AI-calculated deal score 0-100
  dealReason    String?   @db.Text
  
  // Categories
  category      String?
  tags          String[]
  
  // User interaction
  isSaved       Boolean   @default(false)
  isPurchased   Boolean   @default(false)
  notifyOnDrop  Boolean   @default(false)
  targetPrice   Float?    // Price alert threshold
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isSaved])
  @@index([source, category])
  @@index([dealScore])
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Interest details
  interestType  String   // "hobby", "category", "brand", "keyword"
  value         String   // e.g., "gaming", "electronics", "Nike"
  weight        Float    @default(1.0) // How much user cares about this
  
  // Learning
  searchCount   Int      @default(0)
  purchaseCount Int      @default(0)
  lastUsedAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, interestType, value])
  @@index([userId])
}

model PriceAlert {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  
  // Alert settings
  targetPrice   Float
  currentPrice  Float
  alertType     String    @default("drop") // "drop", "threshold"
  
  // Notification
  isTriggered   Boolean   @default(false)
  triggeredAt   DateTime?
  notifiedVia   String[]  // ["email", "telegram", "push"]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isTriggered])
}

// =============================================================================
// ADMIN & SYSTEM MANAGEMENT
// =============================================================================

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  
  // Action details
  action        String   // "create_user", "update_user", "delete_user", "change_role", "update_settings"
  targetType    String   // "user", "settings", "agent", "system"
  targetId      String?  // ID of the affected resource
  targetEmail   String?  // For user-related actions
  
  // Change tracking
  previousValue Json?    // State before change
  newValue      Json?    // State after change
  
  // Context
  ipAddress     String?
  userAgent     String?
  reason        String?  @db.Text
  
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model SystemSetting {
  id          String   @id
  category    String   // "general", "agents", "notifications", "security", "integrations"
  name        String
  value       Json
  description String?
  
  // Access control
  isPublic    Boolean  @default(false)  // Can non-admins see this?
  isEditable  Boolean  @default(true)   // Can it be changed via UI?
  
  // Audit
  updatedBy   String?
  updatedByUser User?  @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
  @@index([category])
}

model ApiKey {
  id          String   @id @default(uuid())
  name        String
  keyHash     String   @unique  // Hashed API key
  keyPrefix   String   // First 8 chars for identification
  
  // Permissions
  permissions String[] // ["read", "write", "admin"]
  rateLimit   Int      @default(1000) // Requests per hour
  
  // Usage tracking
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)
  
  // Status
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keyPrefix])
  @@index([isActive])
}

// Note: FeatureFlag model has been moved to the end of the file with enhanced schema
// for Rule Engine and Feature Flags integration

// =============================================================================
// EXTERNAL API CONFIGURATION
// =============================================================================

model ExternalApiConfig {
  id          String   @id @default(uuid())
  
  // API identification
  name        String   @unique  // e.g., "jsearch", "adzuna", "remoteok"
  displayName String             // Human-readable name
  category    String             // "jobs", "travel", "shopping", etc.
  
  // API configuration
  baseUrl     String?           // Base URL for the API
  apiKeyEnvVar String?          // Environment variable name for API key
  
  // Status
  isEnabled   Boolean  @default(true)
  isHealthy   Boolean  @default(true)
  lastHealthCheck DateTime?
  lastError   String?
  
  // Rate limiting
  rateLimit       Int?      // Requests per period
  rateLimitPeriod String?   // "minute", "hour", "day", "month"
  currentUsage    Int       @default(0)
  usageResetAt    DateTime?
  
  // Metadata
  description String?
  docsUrl     String?
  requiresAuth Boolean  @default(false)
  authType    String?   // "api_key", "oauth", "basic"
  
  // Priority for fallback ordering
  priority    Int       @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isEnabled])
  @@index([name])
}

// =============================================================================
// EMAIL SENDER PATTERN LEARNING
// =============================================================================

model EmailSenderPattern {
  id            String   @id @default(uuid())
  
  // Pattern identification
  senderEmail   String?  // Exact sender email (e.g., "noreply@openai.com")
  senderDomain  String?  // Domain pattern (e.g., "openai.com")
  senderName    String?  // Display name pattern (e.g., "OpenAI")
  subjectPattern String? // Subject line pattern (e.g., "Daily Digest")
  
  // Learned classification
  category      String   // "INVOICE", "JOB_OFFER", "NEWSLETTER", "OFFICIAL", "SPAM", etc.
  customTag     String?  // Custom tag like "OpenAI Updates", "GitHub Notifications"
  
  // Learning metrics
  occurrenceCount Int    @default(1)  // How many times we've seen this pattern
  confidence      Float  @default(0.5) // Confidence in this classification
  lastSeenAt      DateTime @default(now())
  
  // Source tracking
  isUserApproved  Boolean @default(false) // User explicitly approved this rule
  isAutoLearned   Boolean @default(true)  // System learned this pattern
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderDomain, subjectPattern])
  @@index([senderEmail])
  @@index([senderDomain])
  @@index([category])
}

// =============================================================================
// GROCERIES AGENT
// =============================================================================

model GroceryItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Item details
  name          String
  category      String?   // "produce", "dairy", "meat", "pantry", "frozen", "beverages", "snacks", "household"
  quantity      Float     @default(1)
  unit          String?   // "kg", "g", "L", "ml", "pcs", "pack"
  
  // Status tracking
  status        String    @default("available") // "available", "low", "out_of_stock", "expired"
  expiryDate    DateTime?
  
  // Purchase info
  lastPurchasedAt   DateTime?
  lastPurchasePrice Float?
  currency          String    @default("USD")
  purchaseSource    String?   // "manual", "invoice", "receipt", "auto_detected"
  
  // Metadata
  brand         String?
  notes         String?
  barcode       String?
  imageUrl      String?
  
  // Usage tracking for auto-restock suggestions
  avgWeeklyUsage  Float?
  restockThreshold Float?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  listItems     GroceryListItem[]

  @@unique([userId, name, brand])
  @@index([userId, status])
  @@index([userId, category])
  @@index([expiryDate])
}

model GroceryList {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // List details
  name          String
  description   String?
  listType      String    @default("shopping") // "shopping", "inventory", "meal_plan"
  
  // Status
  status        String    @default("active") // "active", "completed", "archived"
  completedAt   DateTime?
  
  // Sharing (future feature)
  isShared      Boolean   @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items         GroceryListItem[]

  @@index([userId, status])
  @@index([userId, listType])
}

model GroceryListItem {
  id        String   @id @default(uuid())
  listId    String
  list      GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  groceryId String?
  grocery   GroceryItem? @relation(fields: [groceryId], references: [id], onDelete: SetNull)
  
  // Item details (can be custom or linked to GroceryItem)
  name          String
  quantity      Float     @default(1)
  unit          String?
  category      String?
  
  // Status
  isChecked     Boolean   @default(false)
  checkedAt     DateTime?
  
  // Price estimate
  estimatedPrice Float?
  actualPrice    Float?
  currency       String   @default("USD")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@index([groceryId])
}

model SavedRecipe {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Recipe details
  title         String
  description   String?   @db.Text
  instructions  String?   @db.Text
  
  // Source info
  source        String    @default("manual") // "manual", "spoonacular", "edamam", "ai_generated", "url"
  sourceUrl     String?
  sourceId      String?   // External recipe ID
  
  // Categorization
  cuisine       String?   // "italian", "mexican", "asian", etc.
  mealType      String?   // "breakfast", "lunch", "dinner", "snack", "dessert"
  dietaryInfo   String[]  // ["vegetarian", "gluten-free", "dairy-free"]
  
  // Ingredients (stored as JSON for flexibility)
  ingredients   Json      // Array of {name, quantity, unit, optional}
  
  // Nutrition (optional, from API)
  nutrition     Json?     // {calories, protein, carbs, fat, fiber, etc.}
  
  // Timing
  prepTime      Int?      // Minutes
  cookTime      Int?      // Minutes
  servings      Int?
  
  // User interaction
  rating        Int?      // 1-5 stars
  notes         String?   @db.Text
  isFavorite    Boolean   @default(false)
  cookedCount   Int       @default(0)
  lastCookedAt  DateTime?
  
  // Media
  imageUrl      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isFavorite])
  @@index([userId, mealType])
  @@index([cuisine])
}

