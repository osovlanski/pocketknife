}

model LearningResource {
  id            String   @id @default(uuid())
  
  // Identification
  name          String
  slug          String   @unique
  type          LearningResourceType
  
  // Platform-specific identifiers
  externalId    String?        // Channel ID, course ID, etc.
  url           String
  
  // Metadata
  description   String?   @db.Text
  focus         String[]       // ['react', 'backend', 'system-design', 'devops']
  difficulty    String?        // 'beginner', 'intermediate', 'advanced'
  language      String    @default("en")
  
  // Creator info
  creatorName   String?
  creatorUrl    String?
  
  // Status
  status        LearningResourceStatus @default(PENDING)
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  
  // Platform-specific stats
  subscriberCount   Int?
  videoCount        Int?
  viewCount         Int?
  lastVideoAt       DateTime?
  
  // Quality indicators
  rating            Float?       // 1-5 stars
  qualityScore      Int?         // 0-100 calculated score
  
  // Discovery
  discoverySource   String?      // "manual", "youtube_api", "user_suggestion"
  discoveredAt      DateTime     @default(now())
  
  // Refresh
  lastRefreshedAt   DateTime?
  refreshErrors     Int          @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([type, externalId])
  @@index([type, status])
  @@index([focus])
  @@index([qualityScore])
}

// =============================================================================
// SEARCH SITE CONFIGURATIONS (Google Custom Search sites per agent)
// =============================================================================

enum AgentTypeEnum {
  SHOPPING
  TRAVEL
  LEARNING
  PROBLEMS
  JOBS
  NEWS
  COOKING
  DIY
  GENERAL
}

model SearchSiteConfig {
  id            String   @id @default(uuid())
  
  // Agent association
  agentType     AgentTypeEnum
  
  // Site details
  domain        String
  displayName   String?
  
  // Search configuration
  searchUrlPattern  String?      // URL template: "https://example.com/search?q={query}"
  priority          Int          @default(100)  // Lower = higher priority
  
  // AI parsing
  parsePrompt       String?      @db.Text  // Custom AI prompt for parsing results
  
  // Status
  isActive          Boolean      @default(true)
  lastTestedAt      DateTime?
  testSuccess       Boolean?
  
  // Geolocation
  country           String?      // ISO country code for geo-specific sites
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([agentType, domain])
  @@index([agentType, isActive])
  @@index([priority])
}

// =============================================================================
// EXTERNAL STORES (E-commerce sites for Shopping agent)
// =============================================================================

enum StoreStatus {
  ACTIVE
  INACTIVE
  SCRAPER_BROKEN
  PENDING
}

model ExternalStore {
  id            String   @id @default(uuid())
  
  // Identification
  name          String
  slug          String   @unique
  domain        String   @unique
  
  // URLs
  websiteUrl    String
  searchUrlPattern  String?    // "https://example.com/search?q={query}"
  
  // Metadata
  description   String?
  logo          String?        // Logo URL
  country       String?        // ISO country code
  currency      String         @default("USD")
  
  // Categories
  categories    String[]       // ['electronics', 'home', 'fashion']
  
  // Scraping configuration
  scraperType       String?    // 'api', 'html', 'google_cse'
  scraperConfig     Json?      // Scraper-specific settings
  
  // Status
  status            StoreStatus @default(PENDING)
  isVerified        Boolean     @default(false)
  verifiedAt        DateTime?
  
  // Performance
  avgResponseTime   Int?        // ms
  successRate       Float?      // 0-1
  lastTestedAt      DateTime?
  
  // Statistics
  productsScraped   Int         @default(0)
  lastScrapedAt     DateTime?
  scrapeErrors      Int         @default(0)
  lastErrorMessage  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([country])
  @@index([categories])
}