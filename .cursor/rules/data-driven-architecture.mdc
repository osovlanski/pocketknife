## Quick Reference

### Import Patterns

```typescript
// External Company Service
import { externalCompanyService } from '../services/jobs/externalCompanyService';

// Prisma Client for direct queries
import { PrismaClient } from '@prisma/client';
const prisma = new PrismaClient();

// Config Service for simple settings
import { configService } from '../services/core/configService';
```

### Common Patterns

```typescript
// Pattern 1: Database-first with fallback
const companies = await this.getCompaniesFromDatabase();
if (companies.length === 0) {
  companies = this.fallbackList;
}

// Pattern 2: Create or update (upsert)
const company = await externalCompanyService.createCompany({
  name: 'New Company',
  atsProvider: 'COMEET',
  atsCompanyId: 'new-company',
  discoverySource: 'manual'
});

// Pattern 3: Filter by status
const activeCompanies = await externalCompanyService.searchCompanies({
  status: 'ACTIVE',
  size: 'STARTUP'
});

// Pattern 4: Scheduled refresh (in a cron job)
await externalCompanyService.refreshCompanyData(100);
```

