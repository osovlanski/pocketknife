## Step 8: Frontend Hook

### File: `frontend/src/hooks/useYourAgent.ts`

```typescript
import { useState, useEffect, useCallback } from 'react';
import * as api from '../services/yourAgentApi';
import type { YourItem } from '../services/yourAgentApi';

export interface UseYourAgentReturn {
  items: YourItem[];
  loading: boolean;
  handleCreate: (data: Partial<YourItem>) => Promise<void>;
  handleDelete: (id: string) => Promise<void>;
  refresh: () => Promise<void>;
}

export const useYourAgent = (): UseYourAgentReturn => {
  const [items, setItems] = useState<YourItem[]>([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    refresh();
  }, []);

  const refresh = useCallback(async () => {
    try {
      setLoading(true);
      const result = await api.getItems();
      setItems(result.items || []);
    } catch (error) {
      console.error('Failed to load items:', error);
    } finally {
      setLoading(false);
    }
  }, []);

  const handleCreate = useCallback(async (data: Partial<YourItem>) => {
    try {
      setLoading(true);
      await api.createItem(data);
      await refresh();
    } catch (error) {
      console.error('Failed to create item:', error);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [refresh]);

  const handleDelete = useCallback(async (id: string) => {
    try {
      await api.deleteItem(id);
      await refresh();
    } catch (error) {
      console.error('Failed to delete item:', error);
    }
  }, [refresh]);

  return { items, loading, handleCreate, handleDelete, refresh };
};

export default useYourAgent;
```

### Update: `frontend/src/hooks/index.ts`

```typescript
export { default as useYourAgent } from './useYourAgent';
export type { UseYourAgentReturn } from './useYourAgent';
```

