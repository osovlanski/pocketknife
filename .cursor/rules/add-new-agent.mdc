## Step 3: Agent Class

### File: `backend/src/agents/YourAgent.ts`

```typescript
/**
 * YourAgent
 * 
 * Description of what your agent does.
 */

import { AbstractAgent } from './AbstractAgent';
import { AgentMetadata, AgentResult, AgentParams } from './types';
import { yourAgentService } from '../services/yourAgent';

interface YourAgentParams extends AgentParams {
  action: 'get-items' | 'create-item' | 'delete-item';
  itemData?: any;
  itemId?: string;
}

interface YourAgentResult {
  items?: any[];
  item?: any;
}

export class YourAgent extends AbstractAgent {
  readonly metadata: AgentMetadata = {
    id: 'your-agent',           // Unique ID (lowercase, hyphenated)
    name: 'Your Agent',          // Display name
    description: 'What your agent does',
    icon: '🔮',                  // Emoji icon
    color: '#8B5CF6'             // Hex color for UI
  };

  protected async run(params: YourAgentParams): Promise<AgentResult<YourAgentResult>> {
    const { action } = params;

    switch (action) {
      case 'get-items':
        return this.getItems(params);
      case 'create-item':
        return this.createItem(params);
      case 'delete-item':
        return this.deleteItem(params);
      default:
        return { success: false, error: `Unknown action: ${action}` };
    }
  }

  private async getItems(params: YourAgentParams): Promise<AgentResult<YourAgentResult>> {
    const { userId } = params;

    if (!userId) return { success: false, error: 'User ID is required' };

    try {
      const items = await yourAgentService.getItems(userId);
      return { success: true, data: { items } };
    } catch (error: any) {
      return { success: false, error: error.message };
    }
  }

  private async createItem(params: YourAgentParams): Promise<AgentResult<YourAgentResult>> {
    const { userId, itemData } = params;

    if (!userId) return { success: false, error: 'User ID is required' };
    if (!itemData) return { success: false, error: 'Item data is required' };

    this.emitLog('📝 Creating item...', 'info');

    try {
      const item = await yourAgentService.createItem(userId, itemData);
      this.emitLog('✅ Item created', 'success');
      return { success: true, data: { item } };
    } catch (error: any) {
      this.emitLog(`❌ Failed: ${error.message}`, 'error');
      return { success: false, error: error.message };
    }
  }

  private async deleteItem(params: YourAgentParams): Promise<AgentResult<YourAgentResult>> {
    // Implementation
    return { success: true };
  }
}

// Export singleton instance
export const yourAgent = new YourAgent();
export default yourAgent;
```

