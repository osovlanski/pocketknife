## Step 2: Backend Service

### File: `backend/src/services/yourAgent/yourAgentService.ts`

```typescript
/**
 * YourAgent Service
 * 
 * Business logic for your agent.
 */

import { getPrisma } from '../core/databaseService';
import { configService } from '../core/configService';
import claudeService from '../core/claudeService';

export interface YourDataType {
  name: string;
  // ... your fields
}

export const yourAgentService = {
  /**
   * Get all items for a user
   */
  getItems: async (userId: string): Promise<any[]> => {
    const prisma = getPrisma();
    if (!prisma) throw new Error('Database not available');

    return prisma.yourModel.findMany({
      where: { userId },
      orderBy: { createdAt: 'desc' }
    });
  },

  /**
   * Create a new item
   */
  createItem: async (userId: string, data: YourDataType): Promise<any> => {
    const prisma = getPrisma();
    if (!prisma) throw new Error('Database not available');

    return prisma.yourModel.create({
      data: {
        userId,
        ...data
      }
    });
  },

  // ... more methods
};

export default yourAgentService;
```

