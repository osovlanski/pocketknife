## Step 4: Controller

### File: `backend/src/controllers/yourAgentController.ts`

```typescript
/**
 * YourAgent Controller
 * 
 * HTTP request handlers. Thin controller - delegates to agent.
 */

import { Request, Response } from 'express';
import { yourAgent } from '../agents';
import { databaseService } from '../services/core/databaseService';

const getUserId = async (req: Request): Promise<string | undefined> => {
  const email = req.headers['x-user-email'] as string;
  if (!email) return undefined;
  const user = await databaseService.getOrCreateUser(email);
  return user?.id;
};

export const getItems = async (req: Request, res: Response) => {
  try {
    const userId = await getUserId(req);
    if (!userId) {
      return res.status(401).json({ success: false, error: 'Authentication required' });
    }

    const result = await yourAgent.execute({
      action: 'get-items',
      userId
    });

    if (!result.success) {
      return res.status(400).json(result);
    }

    res.json(result.data);
  } catch (error: any) {
    res.status(500).json({ success: false, error: error.message });
  }
};

export const createItem = async (req: Request, res: Response) => {
  try {
    const userId = await getUserId(req);
    if (!userId) {
      return res.status(401).json({ success: false, error: 'Authentication required' });
    }

    const result = await yourAgent.execute({
      action: 'create-item',
      userId,
      itemData: req.body
    });

    if (!result.success) {
      return res.status(400).json(result);
    }

    res.json(result.data);
  } catch (error: any) {
    res.status(500).json({ success: false, error: error.message });
  }
};

// ... more handlers
```

