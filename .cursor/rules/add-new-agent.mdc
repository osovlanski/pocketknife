## Step 7: Frontend API Service

### File: `frontend/src/services/yourAgentApi.ts`

```typescript
import axios from 'axios';
import { getStoredEmail } from './authApi';
import { API_BASE_URL } from '../config';

const api = axios.create({ baseURL: API_BASE_URL });
api.interceptors.request.use((config) => {
  const email = getStoredEmail();
  if (email) {
    config.headers['X-User-Email'] = email;
  }
  return config;
});

// Types
export interface YourItem {
  id: string;
  name: string;
  createdAt: string;
}

// API calls
export const getItems = async (): Promise<{ items: YourItem[] }> => {
  const response = await api.get('/your-agent/items');
  return response.data;
};

export const createItem = async (data: Partial<YourItem>): Promise<{ item: YourItem }> => {
  const response = await api.post('/your-agent/items', data);
  return response.data;
};

export const deleteItem = async (id: string): Promise<void> => {
  await api.delete(`/your-agent/items/${id}`);
};
```

