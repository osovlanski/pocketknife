## Step 9: Frontend Component

### File: `frontend/src/components/YourAgent.tsx`

```tsx
import React from 'react';
import { Plus, Loader2 } from 'lucide-react';
import useYourAgent from '../hooks/useYourAgent';
import styles from '../styles/yourAgent.module.css';

const YourAgent: React.FC = () => {
  const agent = useYourAgent();

  return (
    <div className={styles.container}>
      <div className={styles.header}>
        <h1 className={styles.title}>🔮 Your Agent</h1>
        <p className={styles.subtitle}>Description of your agent</p>
      </div>

      {agent.loading ? (
        <div className={styles.loading}>
          <Loader2 className="animate-spin" />
        </div>
      ) : (
        <div className={styles.content}>
          {/* Your content here */}
        </div>
      )}
    </div>
  );
};

export default YourAgent;
```

