## Quick Reference

### Import Patterns

```typescript
// ConfigService
import { configService } from '../services/core/configService';

// Rule Engine
import { ruleEngineService, RuleContext, Rule } from '../services/rules';

// Feature Flags
import { featureFlagService, FlagContext, FeatureFlag } from '../services/featureFlags';
```

### Common Patterns

```typescript
// Pattern 1: Config with fallback
const maxResults = configService.get('agent.maxResults', 20);

// Pattern 2: Conditional business logic
const result = await ruleEngineService.evaluate(context, 'scoring');
const score = result.finalContext.data.score;

// Pattern 3: Feature gate
if (await featureFlagService.isEnabled('new_feature')) {
  // New implementation
} else {
  // Legacy implementation
}

// Pattern 4: A/B test
const variant = await featureFlagService.getVariant('experiment', { userId });
if (variant === 'treatment') {
  // Treatment group
}
```
