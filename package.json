{
  "name": "pocketknife",
  "version": "2.0.0",
  "description": "Pocketknife - Multi-agent AI platform for emails, jobs, travel, and learning",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node backend/dist/index.js",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "dev": "npm run dev --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "test": "node scripts/run-tests.js",
    "test:all": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "quality-check": "node scripts/check-quality.js",
    "review": "node scripts/check-quality.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osovlanski/pocketknife.git"
  },
  "keywords": [
    "pocketknife",
    "ai",
    "multi-agent",
    "email",
    "jobs",
    "travel",
    "learning",
    "automation"
  ],
  "author": "Itay Osov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/osovlanski/pocketknife/issues"
  },
  "homepage": "https://github.com/osovlanski/pocketknife#readme"
}
